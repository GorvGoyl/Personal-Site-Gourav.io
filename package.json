{
    "name": "personal",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "//start": "starts Next.js in development mode",
        "dev": "next dev",
        "dev:debug": "cross-env NODE_OPTIONS='--inspect' next dev",
        "//prod": "starts Next.js in production server.. restart again after code change",
        "start": "next build && next start",
        "dev:vercel": "pnpm dlx vercel dev",
        "vercel:build": "pnpm dlx vercel build",
        "deploy:preview": "pnpm dlx vercel",
        "check-updates": "pnpm update --interactive --latest",
        "//": "//-internal commands-//",
        "//dont use NODE_ENV": "https://github.com/vercel/next.js/blob/master/errors/non-standard-node-env.md",
        "deploy:old": "pnpm run tsc && dotenv -e .env.prod pnpm run export && firebase deploy -P prod --only hosting",
        "build": "next build --debug",
        "sitemap": "node ./scripts/generate-sitemap.mjs",
        "feed": "node ./scripts/generate-rss.mjs",
        "postbuild": "pnpm run sitemap && pnpm run feed",
        "export": "next build && next export",
        "deploy-lint": "pnpm run lint && pnpm run tsc && pnpm run export && firebase deploy --only hosting",
        "tsc": "tsc",
        "myip_mac": "echo http://`ipconfig getifaddr en0`:3000",
        "myip_win": "ipconfig /all && echo 'use like http://laptop_IPv4_address:3000'",
        "lint": "eslint .",
        "test": "vitest watch",
        "//lint-fix": "eslint ./components/** ./pages/** -c .eslintrc.json --fix --ext .js,.jsx,.ts,.tsx,.scss,.mdx"
    },
    "engines": {
        "node": "24.x"
    },
    "dependencies": {
        "@codeium/react-code-editor": "^1.0.12",
        "@jsdevtools/rehype-toc": "^3.0.2",
        "esbuild": "0.28.2",
        "gray-matter": "^4.0.3",
        "hastscript": "^9.0.1",
        "mdx-bundler": "^10.1.1",
        "next": "16.4.3",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-dom-confetti": "^0.2.0",
        "react-medium-image-zoom": "^5.4.9",
        "react-twitter-widgets": "^1.11.0",
        "rehype-autolink-headings": "^7.1.0",
        "rehype-code-titles": "^1.2.1",
        "rehype-mdx-import-media": "^1.4.0",
        "rehype-prism-plus": "^2.0.2",
        "rehype-slug": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "sass": "^1.106.1",
        "sugar-high": "^2.6.4",
        "uuidv7": "^1.2.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@notionhq/client": "^5.28.0",
        "@tailwindcss/typography": "^0.5.20",
        "@types/node": "^24.19.2",
        "@types/react": "19.3.0",
        "autoprefixer": "^10.6.2",
        "cross-env": "^10.1.0",
        "dotenv": "^18.0.9",
        "eslint": "^10.13.0",
        "eslint-config-next": "16.4.3",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-promise": "^7.3.0",
        "eslint-plugin-react-google-translate": "^1.1.0",
        "eslint-plugin-regexp": "^3.3.1",
        "feed": "^6.0.0",
        "globby": "^16.2.4",
        "postcss": "^8.5.32",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^3.4.19",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.0.5",
        "zod": "^4.6.7"
    },
    "pnpm": {
        "overrides": {
            "@types/react": "19.3.0"
        },
        "peerDependencyRules": {
            "allowedVersions": {
                "eslint-plugin-import>eslint": "10",
                "eslint-plugin-jsx-a11y>eslint": "10",
                "eslint-plugin-react>eslint": "10",
                "@codeium/react-code-editor>react": "19",
                "@codeium/react-code-editor>react-dom": "19",
                "@monaco-editor/react>react": "19",
                "@monaco-editor/react>react-dom": "19",
                "react-twitter-widgets>react": "19"
            }
        }
    }
}
